# =============================================================================
# Free-LLM availability dashboard — environment template
# =============================================================================
# Copy to `.env` and fill in your own values. NEVER commit a real `.env`.
#   cp .env.example .env
#
# Provider keys are OPTIONAL — only the providers you configure are probed.
# Providers without a key are skipped (or probed anonymously where supported).
# =============================================================================

# ── Provider keys (add only the providers you use; leave others blank) ───────
OPENROUTER_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=
NVIDIA_NIM_API_KEY=
COHERE_API_KEY=
TOGETHER_API_KEY=
GEMINI_API_KEY=
# HuggingFace Router (HF_TOKEN, not HUGGINGFACE_API_KEY)
HF_TOKEN=
# GitHub Models (GH_MODELS_TOKEN — GITHUB_* is reserved by GitHub Actions)
GH_MODELS_TOKEN=
MISTRAL_API_KEY=
# Cloudflare Workers AI (10k neurons/day free)
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
# Additional free-tier providers (optional)
POLLINATIONS_API_KEY=
KLUSTER_API_KEY=
LLM7_API_KEY=
ZAI_API_KEY=
